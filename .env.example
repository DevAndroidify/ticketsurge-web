# Copy to .env if your backend does not use the defaults: cp .env.example .env
# Read only by the Vite dev/preview server, which proxies these so the browser needs no CORS.
# Nothing here is sent to the browser.

WEB_PORT=5173

# TicketSurge backend (defaults match the backend's .env.example)
API_URL=http://localhost:3000
REALTIME_URL=http://localhost:3001
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3002
KAFKA_UI_URL=http://localhost:8080

# Every run gets a fresh event, created by this server with an account in the backend's
# ADMIN_EMAILS. The default address is already there, and on first use the account is registered
# with a random password stored in .demo-admin.json (gitignored). Set these only if your backend
# uses a different admin address, or the account already exists with a password you chose.
# DEMO_ADMIN_EMAIL=admin@ticketsurge.local
# DEMO_ADMIN_PASSWORD=
